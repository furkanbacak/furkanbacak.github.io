---
import publicationsData from '../data/publications.json';
---

<section id="research" class="section research grid-noise">
  <div class="shell">
    <div class="eyebrow reveal">Research / 003</div>
    <h2 class="section-title reveal">Observe deeply.<br /><span class="ghost">Explain clearly.</span></h2>

    <div class="thesis reveal">
      <div class="thesis-map" aria-hidden="true">
        <div class="roof roof-a"></div><div class="roof roof-b"></div><div class="roof roof-c"></div>
        <span class="micro">LiDAR sample / roof topology</span>
      </div>
      <div class="thesis-copy">
        <span class="micro">Master's thesis · TU Berlin · In progress</span>
        <h3>Efficient and explainable roof intelligence from airborne LiDAR.</h3>
        <p>
          Comparing geometric machine learning and point-based deep learning for
          roof-type classification—looking beyond accuracy toward interpretability,
          compute cost and real-world robustness.
        </p>
        <div class="thesis-tags micro"><span>118K buildings</span><span>Point clouds</span><span>Explainable AI</span></div>
      </div>
    </div>

    <div class="publication-list reveal">
      {publicationsData.map((pub, index) => (
        <a href={pub.url} target="_blank" rel="noopener noreferrer">
          <span class="micro">0{index + 1} / {pub.date.slice(-4)}</span>
          <strong>{pub.title}</strong>
          <span>{pub.publisher}</span>
          <i>↗</i>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .research { background-color: #090c0a; }
  .thesis { display: grid; grid-template-columns: 1fr 1fr; min-height: 500px; border: 1px solid rgba(255,255,255,.13); background: rgba(7,9,8,.84); }
  .thesis-map { position: relative; overflow: hidden; background: radial-gradient(circle at center, rgba(141,232,255,.13), transparent 55%); border-right: 1px solid rgba(255,255,255,.13); }
  .thesis-map::before { content: ""; position: absolute; inset: 0; background-image: radial-gradient(rgba(141,232,255,.5) 1px, transparent 1px); background-size: 18px 18px; mask-image: radial-gradient(circle, black, transparent 72%); }
  .thesis-map > span { position: absolute; left: 1.3rem; bottom: 1.2rem; color: var(--ice); }
  .roof { position: absolute; border: 1px solid var(--acid); transform: rotate(30deg) skew(-18deg); box-shadow: 0 0 35px rgba(223,255,94,.09); }
  .roof::after { content: ""; position: absolute; inset: 50% -40% auto; border-top: 1px solid rgba(223,255,94,.55); }
  .roof-a { width: 180px; height: 120px; left: 27%; top: 25%; }
  .roof-b { width: 100px; height: 80px; left: 57%; top: 48%; opacity: .55; }
  .roof-c { width: 75px; height: 55px; left: 20%; top: 62%; opacity: .35; }
  .thesis-copy { align-self: center; padding: clamp(2rem, 6vw, 5rem); }
  .thesis-copy > span { color: var(--acid); }
  .thesis-copy h3 { margin: 1.6rem 0; font-size: clamp(2rem, 4vw, 4.2rem); line-height: 1; letter-spacing: -.05em; font-weight: 500; }
  .thesis-copy p { color: var(--muted); line-height: 1.75; }
  .thesis-tags { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 2rem; }
  .thesis-tags span { padding: .6rem .7rem; border: 1px solid rgba(255,255,255,.13); color: #bfc4bf; }
  .publication-list { margin-top: 5rem; border-top: 1px solid rgba(255,255,255,.15); }
  .publication-list a { display: grid; grid-template-columns: 8rem 1fr 12rem 2rem; gap: 1.5rem; align-items: center; padding: 1.5rem 0; border-bottom: 1px solid rgba(255,255,255,.11); text-decoration: none; transition: color .25s, padding .25s; }
  .publication-list a > span { color: #737b75; }
  .publication-list strong { font-size: 1.05rem; font-weight: 500; }
  .publication-list i { color: var(--acid); font-style: normal; }
  .publication-list a:hover { color: var(--acid); padding-left: .5rem; }
  @media (max-width: 760px) { .thesis { grid-template-columns: 1fr; } .thesis-map { min-height: 320px; border-right: 0; border-bottom: 1px solid rgba(255,255,255,.13); } .publication-list a { grid-template-columns: 4rem 1fr 2rem; } .publication-list a > span:nth-of-type(2) { display: none; } }
</style>
