<section id="top" class="hero grid-noise">
  <canvas id="field" aria-hidden="true"></canvas>
  <div class="hero-vignette"></div>
  <div class="shell hero-inner">
    <div class="hero-copy">
      <div class="status micro"><span></span> Berlin / available for meaningful systems</div>
      <h1>
        I make complex<br />
        systems <em>legible.</em>
      </h1>
      <p>
        Geospatial engineer and developer advocate working across
        <strong>maps, APIs, products and people.</strong>
      </p>
      <div class="hero-actions">
        <a class="primary" href="#work">Explore selected work <span>↓</span></a>
        <a href="https://github.com/furkanbacak" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href="https://medium.com/@fbacak" target="_blank" rel="noopener noreferrer">Writing ↗</a>
      </div>
    </div>

    <aside class="telemetry" aria-label="Current focus">
      <div class="telemetry-head micro"><span>Live context</span><span>2026.07</span></div>
      <div class="coordinate">
        <span>52.5200° N</span><span>13.4050° E</span>
      </div>
      <div class="telemetry-row"><span>01</span><strong>Spatial intelligence</strong><i>ACTIVE</i></div>
      <div class="telemetry-row"><span>02</span><strong>Developer experience</strong><i>ACTIVE</i></div>
      <div class="telemetry-row"><span>03</span><strong>Technical narrative</strong><i>ACTIVE</i></div>
    </aside>
  </div>
  <div class="scroll micro">Scroll to decode <span>↓</span></div>
</section>

<script>
  const canvas = document.querySelector('#field');
  if (canvas instanceof HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let w = 0, h = 0, frame = 0;
    let points = [];
    const resize = () => {
      const dpr = Math.min(devicePixelRatio, 2);
      w = canvas.clientWidth; h = canvas.clientHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
      points = Array.from({ length: Math.min(150, Math.floor(w / 7)) }, (_, i) => ({
        x: w * (.51 + Math.random() * .47),
        y: h * (.08 + Math.random() * .79),
        z: Math.random(),
        p: i * .45 + Math.random() * 4
      }));
    };
    const draw = () => {
      if (!ctx) return;
      ctx.clearRect(0, 0, w, h);
      points.forEach((pt) => {
        const drift = reduce ? 0 : Math.sin(frame * .006 + pt.p) * 16;
        const x = pt.x + drift * pt.z;
        const y = pt.y + Math.cos(frame * .004 + pt.p) * 8;
        ctx.fillStyle = pt.z > .82 ? 'rgba(223,255,94,.9)' : `rgba(141,232,255,${.12 + pt.z * .42})`;
        ctx.fillRect(x, y, 1 + pt.z * 2.2, 1 + pt.z * 2.2);
        if (pt.z > .73) {
          ctx.strokeStyle = 'rgba(141,232,255,.09)';
          ctx.beginPath(); ctx.moveTo(x - 12, y); ctx.lineTo(x + 12, y); ctx.stroke();
        }
      });
      frame++;
      if (!reduce) requestAnimationFrame(draw);
    };
    resize(); draw();
    window.addEventListener('resize', resize);
  }
</script>

<style>
  .hero { min-height: 100svh; position: relative; overflow: hidden; display: flex; align-items: center; border-bottom: 1px solid rgba(255,255,255,.1); }
  #field { position: absolute; inset: 0; width: 100%; height: 100%; opacity: .82; }
  .hero-vignette { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(7,9,8,.98) 0%, rgba(7,9,8,.85) 40%, rgba(7,9,8,.1) 78%), linear-gradient(0deg, var(--ink), transparent 22%); }
  .hero-inner { position: relative; z-index: 2; padding-top: 8rem; }
  .hero-copy { max-width: 940px; }
  .status { color: #a8afaa; display: flex; align-items: center; gap: .8rem; margin-bottom: 2.5rem; }
  .status span { width: 8px; height: 8px; border-radius: 50%; background: var(--acid); box-shadow: 0 0 20px var(--acid); animation: pulse 2s ease-in-out infinite; }
  h1 { margin: 0; max-width: 1040px; font-size: clamp(4rem, 9.5vw, 9.2rem); line-height: .82; font-weight: 500; letter-spacing: -.075em; }
  h1 em { color: transparent; -webkit-text-stroke: 1px rgba(223,255,94,.8); font-style: normal; }
  .hero-copy > p { max-width: 580px; color: #a7ada8; margin: 2.8rem 0 0; font-size: clamp(1.05rem, 1.8vw, 1.35rem); line-height: 1.55; }
  .hero-copy p strong { color: #f4f5f1; font-weight: 500; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.6rem; margin-top: 2.2rem; }
  .hero-actions a { color: #aeb4af; text-decoration: none; font: 500 .72rem var(--font-mono); text-transform: uppercase; letter-spacing: .08em; }
  .hero-actions .primary { display: flex; justify-content: space-between; align-items: center; min-width: 255px; padding: 1.1rem 1.25rem; color: #070908; background: var(--acid); }
  .telemetry { position: absolute; right: 0; bottom: -8rem; width: 390px; background: rgba(9,13,11,.8); border: 1px solid rgba(255,255,255,.12); backdrop-filter: blur(16px); }
  .telemetry-head, .coordinate, .telemetry-row { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.2rem; border-bottom: 1px solid rgba(255,255,255,.1); }
  .telemetry-head { color: #707772; }
  .coordinate { color: var(--ice); font: 400 .75rem var(--font-mono); }
  .telemetry-row { gap: 1rem; font-size: .76rem; }
  .telemetry-row > span { color: #56605a; font: 400 .64rem var(--font-mono); }
  .telemetry-row strong { margin-right: auto; font-weight: 500; }
  .telemetry-row i { color: var(--acid); font: normal .55rem var(--font-mono); }
  .scroll { position: absolute; z-index: 2; left: 24px; bottom: 24px; color: #69706c; writing-mode: vertical-rl; }
  .scroll span { color: var(--acid); margin-top: .6rem; }
  @keyframes pulse { 50% { opacity: .35; } }
  @media (max-width: 900px) { .telemetry { display: none; } .hero-vignette { background: linear-gradient(90deg, rgba(7,9,8,.97), rgba(7,9,8,.6)); } }
  @media (max-width: 700px) {
    .hero { min-height: 840px; }
    .hero-inner { padding-top: 5rem; }
    .scroll { display: none; }
    h1 { font-size: clamp(3.7rem, 18vw, 6rem); }
    .hero-copy > p { max-width: 100%; font-size: 1rem; overflow-wrap: anywhere; }
    .hero-actions { align-items: stretch; gap: 1rem 1.4rem; }
    .hero-actions .primary { flex-basis: 100%; min-width: 0; }
  }
</style>
