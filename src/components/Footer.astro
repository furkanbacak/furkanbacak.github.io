---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell">
    <div class="eyebrow">Contact / 004</div>
    <div class="footer-main">
      <h2>Have a complex idea?<br /><span>Let's make it clear.</span></h2>
      <a href="https://www.linkedin.com/in/furkanbacak/" target="_blank" rel="noopener noreferrer">Start a conversation ↗</a>
    </div>
    <div class="footer-bottom micro">
      <span>© {currentYear} Furkan Bacak</span>
      <div><a href="https://github.com/furkanbacak">GitHub</a><a href="https://medium.com/@fbacak">Medium</a><a href="https://linkedin.com/in/furkanbacak">LinkedIn</a></div>
      <span>Berlin · 52.5200° N</span>
    </div>
  </div>
</footer>

<style>
  .footer { padding: 8rem 0 2rem; background: var(--acid); color: #070908; }
  .footer .eyebrow { color: #070908; }
  .footer-main { display: flex; align-items: end; justify-content: space-between; gap: 3rem; padding: 3rem 0 8rem; }
  h2 { margin: 0; font-size: clamp(3.2rem, 8vw, 8.5rem); line-height: .86; letter-spacing: -.07em; font-weight: 500; }
  h2 span { color: rgba(7,9,8,.42); }
  .footer-main > a { flex: none; padding: 1.1rem 1.2rem; border: 1px solid #070908; font: 500 .7rem var(--font-mono); text-decoration: none; text-transform: uppercase; }
  .footer-bottom { display: flex; align-items: center; justify-content: space-between; padding-top: 1.4rem; border-top: 1px solid rgba(7,9,8,.3); }
  .footer-bottom div { display: flex; gap: 1.5rem; }
  .footer-bottom a { text-decoration: none; }
  @media (max-width: 760px) { .footer-main { align-items: start; flex-direction: column; padding-bottom: 5rem; } .footer-bottom { align-items: start; flex-direction: column; gap: 1.3rem; } }
</style>
