---
interface Props {
  project: {
    id: string;
    title: string;
    role: string;
    description: string;
    url: string;
    thumbnail: string;
  };
  index: number;
}
const { project, index } = Astro.props;
---

<article class="project reveal">
  <a href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.title}`}>
    <div class="project-visual">
      <img src={project.thumbnail} alt="" loading="lazy" />
      <span class="micro">Open project ↗</span>
    </div>
    <div class="project-meta">
      <span class="index">0{index + 1}</span>
      <h3>{project.title}</h3>
      <p>{project.description}</p>
      <span class="role">{project.role}</span>
    </div>
  </a>
</article>

<style>
  .project { border-top: 1px solid rgba(255,255,255,.15); }
  .project > a { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2rem, 6vw, 6rem); padding: 2.3rem 0; text-decoration: none; }
  .project-visual { position: relative; min-height: 340px; overflow: hidden; background: #111; }
  .project-visual::after { content: ""; position: absolute; inset: 0; border: 1px solid rgba(255,255,255,.13); transition: border-color .3s; }
  .project-visual img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.55) brightness(.72); transition: transform .7s cubic-bezier(.2,.7,.2,1), filter .4s; }
  .project-visual span { position: absolute; z-index: 2; right: 1rem; bottom: 1rem; padding: .65rem .8rem; color: #070908; background: var(--acid); opacity: 0; transform: translateY(8px); transition: .3s; }
  .project-meta { display: grid; grid-template-columns: 3rem 1fr; align-content: center; }
  .index { color: var(--acid); font: .7rem var(--font-mono); }
  h3 { margin: 0; font-size: clamp(2.4rem, 5vw, 5rem); line-height: .95; letter-spacing: -.055em; font-weight: 500; }
  p { grid-column: 2; max-width: 520px; margin: 2rem 0; color: var(--muted); font-size: 1rem; line-height: 1.7; }
  .role { grid-column: 2; color: #d7dbd5; font: .65rem var(--font-mono); letter-spacing: .07em; text-transform: uppercase; }
  a:hover .project-visual img { transform: scale(1.035); filter: saturate(1) brightness(.9); }
  a:hover .project-visual span { opacity: 1; transform: none; }
  a:hover .project-visual::after { border-color: rgba(223,255,94,.5); }
  @media (max-width: 760px) { .project > a { grid-template-columns: 1fr; } .project-visual { min-height: 250px; } .project-meta { padding-bottom: 1rem; } }
</style>
